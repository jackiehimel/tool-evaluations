 lib/changelog.ts        |  55 ++++++++++++++++++
 lib/garage-content.ts   |   1 +
 tests/changelog.test.ts | 123 ++++++++++++++++++++++++++++++++++++++++
 4 files changed, 217 insertions(+)
 create mode 100644 app/changelog/page.tsx
 create mode 100644 lib/changelog.ts
 create mode 100644 tests/changelog.test.ts

diff --git a/app/changelog/page.tsx b/app/changelog/page.tsx
new file mode 100644
index 0000000..9d9b749
--- /dev/null
+++ b/app/changelog/page.tsx
@@ -0,0 +1,38 @@
+import { listChangelogEntries } from "@/lib/changelog";
+
+export default function ChangelogPage() {
+  const entries = listChangelogEntries();
+
+  return (
+    <main className="page-wrap">
+      <h1 className="page-title">Changelog</h1>
+      <p className="page-subtitle">
+        Every logged update across the agent registry, newest first.
+      </p>
+
+      <section className="detail-block mt-8">
+        {entries.length === 0 ? (
+          <p className="m-0 text-[15px] text-[var(--ink-faint)]">
+            No updates yet.
+          </p>
+        ) : (
+          <ul className="m-0 list-none space-y-4 p-0">
+            {entries.map((entry, index) => (
+              <li
+                key={`${entry.agentId}-${entry.date}-${entry.author}-${index}`}
+                className="border-t border-[var(--rule-soft)] pt-4 first:border-t-0 first:pt-0"
+              >
+                <p className="m-0 text-[13.5px] font-medium text-[var(--ink-faint)]">
+                  {entry.date} · {entry.agentName} · {entry.author}
+                </p>
+                <p className="mb-0 mt-1 text-[15px] leading-6 text-[var(--ink-soft)]">
+                  {entry.note}
+                </p>
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+    </main>
+  );
+}
diff --git a/lib/changelog.ts b/lib/changelog.ts
new file mode 100644
index 0000000..ce991c9
--- /dev/null
+++ b/lib/changelog.ts
@@ -0,0 +1,55 @@
+import { agentLibrary, backlogAgents } from "./agent-registry";
+
+const UNKNOWN_AUTHOR = "unknown";
+
+/**
+ * Looser than `AgentUpdate` on purpose: the changelog feed is built by
+ * combining every agent in the registry, and it must stay resilient to an
+ * update entry that (for whatever reason) never got an author.
+ */
+export type ChangelogSourceUpdate = {
+  date: string;
+  author?: string;
+  note: string;
+};
+
+export type ChangelogSource = {
+  id: string;
+  title: string;
+  updates?: ChangelogSourceUpdate[];
+};
+
+export type ChangelogEntry = {
+  date: string;
+  agentId: string;
+  agentName: string;
+  author: string;
+  note: string;
+};
+
+/** Registry dates are ISO strings; the feed always shows the YYYY-MM-DD part. */
+export function formatChangelogDate(date: string): string {
+  return date.slice(0, 10);
+}
+
+export function buildChangelogEntries(agents: ChangelogSource[]): ChangelogEntry[] {
+  const entries: ChangelogEntry[] = agents.flatMap((agent) =>
+    (agent.updates ?? []).map((update) => ({
+      date: formatChangelogDate(update.date),
+      agentId: agent.id,
+      agentName: agent.title,
+      author: update.author?.trim() || UNKNOWN_AUTHOR,
+      note: update.note,
+    })),
+  );
+
+  return entries.sort((a, b) => {
+    const byDate = b.date.localeCompare(a.date);
+    if (byDate !== 0) return byDate;
+    return a.agentName.localeCompare(b.agentName);
+  });
+}
+
+export function listChangelogEntries(): ChangelogEntry[] {
+  return buildChangelogEntries([...agentLibrary, ...backlogAgents]);
+}
