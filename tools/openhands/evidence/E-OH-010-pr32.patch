diff --git a/tests/changelog.test.ts b/tests/changelog.test.ts
new file mode 100644
index 0000000..1ded077
--- /dev/null
+++ b/tests/changelog.test.ts
@@ -0,0 +1,123 @@
+import { describe, it, expect } from "vitest";
+import {
+  buildChangelogEntries,
+  formatChangelogDate,
+  listChangelogEntries,
+  type ChangelogSource,
+} from "@/lib/changelog";
+
+describe("formatChangelogDate", () => {
+  it("keeps a bare YYYY-MM-DD date as is", () => {
+    expect(formatChangelogDate("2026-08-07")).toBe("2026-08-07");
+  });
+
+  it("truncates a full ISO timestamp to YYYY-MM-DD", () => {
+    expect(formatChangelogDate("2026-08-07T15:04:05.000Z")).toBe(
+      "2026-08-07",
+    );
+  });
+});
+
+describe("buildChangelogEntries", () => {
+  it("skips an agent with no updates", () => {
+    const agents: ChangelogSource[] = [
+      { id: "quiet-agent", title: "Quiet Agent" },
+      { id: "empty-agent", title: "Empty Agent", updates: [] },
+    ];
+    expect(buildChangelogEntries(agents)).toEqual([]);
+  });
+
+  it("combines updates from every agent into one feed, newest first", () => {
+    const agents: ChangelogSource[] = [
+      {
+        id: "agent-a",
+        title: "Agent A",
+        updates: [
+          { date: "2026-08-01", author: "Ann", note: "Kickoff." },
+          { date: "2026-08-10", author: "Ann", note: "Shipped v1." },
+        ],
+      },
+      {
+        id: "agent-b",
+        title: "Agent B",
+        updates: [{ date: "2026-08-05", author: "Bo", note: "Claimed." }],
+      },
+    ];
+
+    const entries = buildChangelogEntries(agents);
+    expect(entries.map((entry) => entry.date)).toEqual([
+      "2026-08-10",
+      "2026-08-05",
+      "2026-08-01",
+    ]);
+    expect(entries[0]).toMatchObject({
+      agentId: "agent-a",
+      agentName: "Agent A",
+      author: "Ann",
+      note: "Shipped v1.",
+    });
+  });
+
+  it("orders same-day updates by agent name", () => {
+    const agents: ChangelogSource[] = [
+      {
+        id: "zeta-agent",
+        title: "Zeta Agent",
+        updates: [{ date: "2026-08-10", author: "Zed", note: "Zeta update." }],
+      },
+      {
+        id: "alpha-agent",
+        title: "Alpha Agent",
+        updates: [
+          { date: "2026-08-10", author: "Al", note: "Alpha update." },
+        ],
+      },
+    ];
+
+    const entries = buildChangelogEntries(agents);
+    expect(entries.map((entry) => entry.agentName)).toEqual([
+      "Alpha Agent",
+      "Zeta Agent",
+    ]);
+  });
+
+  it("shows 'unknown' when an update is missing an author", () => {
+    const agents: ChangelogSource[] = [
+      {
+        id: "agent-c",
+        title: "Agent C",
+        updates: [{ date: "2026-08-10", note: "No author given." }],
+      },
+    ];
+
+    const entries = buildChangelogEntries(agents);
+    expect(entries[0].author).toBe("unknown");
+  });
+
+  it("shows 'unknown' when an update's author is blank", () => {
+    const agents: ChangelogSource[] = [
+      {
+        id: "agent-d",
+        title: "Agent D",
+        updates: [{ date: "2026-08-10", author: "   ", note: "Blank author." }],
+      },
+    ];
+
+    const entries = buildChangelogEntries(agents);
+    expect(entries[0].author).toBe("unknown");
+  });
+});
+
+describe("listChangelogEntries", () => {
+  it("returns a feed sourced from the live registry", () => {
+    const entries = listChangelogEntries();
+    expect(Array.isArray(entries)).toBe(true);
+    entries.forEach((entry) => {
+      expect(entry.date).toMatch(/^\d{4}-\d{2}-\d{2}$/);
+      expect(entry.author.length).toBeGreaterThan(0);
+    });
+    for (let i = 1; i < entries.length; i += 1) {
+      expect(entries[i - 1].date >= entries[i].date).toBe(true);
+    }
+  });
+});
